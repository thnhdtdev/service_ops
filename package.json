{
  "name": "service-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "tsc --project backend/tsconfig.json",
    "start:backend": "node backend/dist/server.js",
    "typecheck:backend": "tsc --project backend/tsconfig.json --noEmit",
    "lint:frontend": "npm --prefix frontend run lint",
    "format:frontend": "npm --prefix frontend run format",
    "format:check:frontend": "npm --prefix frontend run format:check",
    "test:backend": "tsx --test backend/src/app.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.1",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
